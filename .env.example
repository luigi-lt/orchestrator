# Orchestrator MVP — local (personal) deployment.
# Copy to .env (./bin/orchestrator init does it for you) and fill in the values below.
# .env is git-ignored. Each secret is passed only to the service that needs it.

# --- GitHub ------------------------------------------------------------------
# Fine-grained personal access token for the repositories below, with:
#   Repository permissions: Contents (read and write), Issues (read and write),
#   Pull requests (read and write), Metadata (read).
GITHUB_TOKEN=
# Repositories the orchestrator watches and may work on (comma-separated owner/name).
GITHUB_REPOS=owner/repo
# Label that hands an issue to the orchestrator (only when you add it yourself).
ORCH_TRIGGER_LABEL=ai-ready

# --- Model ---------------------------------------------------------------------
# Anthropic API key (console.anthropic.com). Used only by the egress proxy; agents never see it.
# A Claude Pro/Max subscription cannot be used here. Set a monthly spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=
# Model for all agents. claude-sonnet-5-5 is cheaper; claude-opus-5-5 is more capable.
ORCH_MODEL=claude-opus-5-5

# --- Local settings ---------------------------------------------------------------
# Generated by ./bin/orchestrator init. Signs the step-scoped tokens of agent sandboxes.
WORKSPACE_TOKEN_SECRET=
# Web app port on 127.0.0.1.
ORCH_PORT=3000
# How often GitHub is polled for labelled issues.
POLL_INTERVAL_SECONDS=60
# Agent sandbox limits.
WORKSPACE_MEMORY_MB=4096
WORKSPACE_CPUS=2
STEP_TIMEOUT_MINUTES=60
# Set to 1 to include a JDK (17) in the sandbox image for Java/Gradle repositories.
WORKSPACE_WITH_JDK=0
# Extra hosts sandboxes may reach (comma-separated); empty = default package registries.
EGRESS_ALLOWLIST=
# Docker socket on the host (Podman: e.g. /run/user/1000/podman/podman.sock).
DOCKER_SOCKET_PATH=/var/run/docker.sock
