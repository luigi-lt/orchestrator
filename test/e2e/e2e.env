# Dummy values for the end-to-end overlay (real services are replaced by fakes).
GITHUB_TOKEN=fake-token
ORCH_PRODUCTS_FILE=../../test/e2e/products.yaml
ANTHROPIC_API_KEY=fake-key
WORKSPACE_TOKEN_SECRET=e2e-only-secret-not-for-real-use-0123456789
