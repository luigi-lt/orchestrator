{
  "name": "orchestrator",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @orch/web",
    "typecheck": "tsc -b && npm run typecheck -w @orch/web",
    "test": "tsc -b && vitest run",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
